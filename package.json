{
  "name": "assessmenthelpers",
  "version": "1.0.0",
  "description": "Assessment Helpers are a suite of Tampermonkey userscripts for Canvas to help with assessment, groups and setting up rubrics.  Userscripts appear only on pages they are coded for and add functionality",
  "main": "canvas-assessment-helper-dock.user.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:theme": "node scripts/build-theme.mjs",
    "check:theme": "node scripts/build-theme.mjs --check",
    "check:userscripts": "node scripts/check-userscripts.mjs",
    "dev:loaders": "node scripts/create-dev-loaders.mjs",
    "test": "npm run check:theme && npm run check:userscripts && npm run test:migration && npm run test:eta && npm run test:theme && npm run test:panels && npm run test:dock",
    "test:migration": "node tests/legacy-storage.cjs",
    "test:panels": "node tests/panels-theme-smoke.cjs",
    "test:theme": "node tests/theme-smoke.cjs",
    "test:eta": "node tests/eta-breaks.cjs",
    "test:dock": "node tests/dock-smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DashDot-Dash/AssessmentHelpers.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DashDot-Dash/AssessmentHelpers/issues"
  },
  "homepage": "https://github.com/DashDot-Dash/AssessmentHelpers#readme",
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
